{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "rootDir": "host",
    "outDir": "dist-host",
    "declaration": false
  },
  "include": ["host/**/*.ts"]
}
