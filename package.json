{
  "name": "tekes-web-ui",
  "version": "0.1.11",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "An independent TypeScript workspace for Tekes agents.",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TekesApps/TekesWebUI.git"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run icons:check && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "tsx --test tests/*.test.ts",
    "preview": "vite preview --host 127.0.0.1",
    "check:clientkit": "tsx scripts/check-clientkit-transcript.ts",
    "icons:check": "tsx scripts/check-icons.ts"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@tekesagentkit/client-contract": "https://codeload.github.com/TekesApps/TekesAgentKit/tar.gz/a1cd0a36e4f9bc95595111834fff2f95d66f3452",
    "@tekesui/icons": "https://codeload.github.com/TekesApps/TekesUI/tar.gz/80d6b05649234f953ea452d42e1cbed369fdddbb",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@types/jsdom": "30.0.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "27.0.1",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
